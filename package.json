{
  "name": "@xcrapcc/sdk",
  "version": "1.3.0",
  "description": "Official Node client for XCrap \u2014 X/Twitter posts, threads, profiles, timelines and media as JSON or LLM-ready markdown. No API key.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "xcrap",
    "twitter",
    "x",
    "scraper",
    "api",
    "markdown",
    "llm",
    "sdk"
  ],
  "homepage": "https://xcrap.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XcrapCC/xcrap-node.git"
  },
  "bugs": {
    "url": "https://github.com/XcrapCC/xcrap-node/issues"
  },
  "license": "MIT",
  "sideEffects": false
}
